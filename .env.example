# Telegram (required for the Telegram download bot)
TELEGRAM_BOT_TOKEN=0000000000:dummy-token
TELEGRAM_CHAT_ID=000000000

# TMDb (optional, improves metadata)
TMDB_API_KEY=tmdb_dummy_api_key

# Local directories
INBOX_DIR=~/Documents/Torrent
TORRENT_DROP_DIR=~/Downloads
GAME_DOWNLOAD_DIR=/Volumes/Datos/Descargas
# Optional: sibling ps5-price-bot directory.
PRICE_BOT_DIR=/Volumes/Datos/Proyectos/Scripts/ps5-price-bot

# Direct downloads
GAME_MAX_RETRIES=20
GAME_RETRY_DELAY=5
GAME_MAX_CONCURRENT=2
TELEGRAM_LOG_LINES=30
LOG_ALERT_POLL_SECONDS=2
LOG_ALERT_DEDUP_SECONDS=300
LOG_ALERT_MAX_CHARS=3000
# Optional: defaults to ~/.local/share/emby_organizer/state.sqlite3
EMBY_STATE_DB=
EMBY_STORAGE_REFRESH_SECONDS=300

# Remote Emby libraries via SFTP
EMBY_SFTP_ANIME_URL=sftp://user@example-host:2222/path/Anime
EMBY_SFTP_SERIES_URL=sftp://user@example-host:2222/path/Series
EMBY_SFTP_MOVIES_URL=sftp://user@example-host:2222/path/Peliculas
EMBY_SFTP_PASSWORD=

# Used by scripts/emby-watch-refresh.sh on the Emby server/LXC
EMBY_WATCH_DIR=/media/Peliculas/Biblioteca
EMBY_URL=http://127.0.0.1:8096
EMBY_API_KEY=emby_dummy_api_key
COOLDOWN=180
MIN_REFRESH_INTERVAL=300
